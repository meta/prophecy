{
  "name": "prophecy",
  "version": "2.0.0",
  "author": "facebook",
  "description": "Static taint analysis for TypeScript with first-class VS Code extension support",
  "license": "MIT",
  "main": "dist/index.js",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "./node_modules/.bin/tsc",
    "build:watch": "./node_modules/.bin/tsc --watch",
    "test": "jest --config jest.static.config.js",
    "test:pnpm": "node tests/pnpm-extension.test.js",
    "test:watch": "jest --config jest.static.config.js --watch",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "analyze": "node dist/index.js",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^20.19.33",
    "typescript": "^5.9.3",
    "xxhash-wasm": "^1.1.0",
    "yargs": "^17.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/vscode": "^1.109.0",
    "@types/yargs": "^17.0.35",
    "jest": "^29.7.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.86.0",
    "ts-jest": "^29.4.6"
  }
}
